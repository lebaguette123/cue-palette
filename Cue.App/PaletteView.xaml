<UserControl
    x:Class="Cue_App.PaletteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:search="using:Cue.Core.Search"
    RequestedTheme="Dark">

    <UserControl.Resources>
        <DataTemplate x:Key="ResultTemplate" x:DataType="search:SearchResult">
            <StackPanel Margin="16,0,8,0" Spacing="2">
                <TextBlock Text="{x:Bind Title}" FontSize="14" Foreground="#E8E4DC" />
                <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="#8B95A1" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid Background="#15191E" BorderBrush="#2B333C" BorderThickness="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBox x:Name="SearchBox"
                 Margin="12"
                 FontSize="16"
                 PlaceholderText="Type a command" />
        
        <ListView x:Name="ResultList"
                  Grid.Row="1"
                  Margin="8,0,8,8"
                  Padding="0,0,12,0"
                  SelectionMode="Single"
                  ItemTemplate="{StaticResource ResultTemplate}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="48" />
                    <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ListViewItemPresenter
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    CornerRadius="3"
                                    PointerOverBackground="#1B2128"
                                    PressedBackground="#1E252D"
                                    SelectedBackground="#222A33"
                                    SelectedPointerOverBackground="#27303A"
                                    SelectedPressedBackground="#27303A"
                                    SelectionIndicatorBrush="#D69A3A"
                                    SelectionIndicatorPointerOverBrush="#D69A3A"
                                    SelectionIndicatorPressedBrush="#D69A3A" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>